{
  "name": "college-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node worker/index.ts",
    "worker:dev": "node --env-file=.env.local --watch worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local db/seed/base.ts",
    "seed:demo": "node --env-file-if-exists=.env.local db/seed/demo.ts",
    "check:types": "next typegen && tsc --noEmit",
    "check:lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:hardcode": "node scripts/check-hardcode.mjs",
    "check:boundaries": "depcruise src worker db --config .dependency-cruiser.cjs",
    "check:unused": "knip",
    "check:secrets": "gitleaks git --redact --verbose",
    "check:all": "pnpm check:types && pnpm check:lint && pnpm test && pnpm check:hardcode && pnpm check:boundaries"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.6.0",
    "drizzle-kit": "0.31.11",
    "knip": "6.42.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
