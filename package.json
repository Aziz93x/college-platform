{
  "name": "college-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:types": "next typegen && tsc --noEmit",
    "check:lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:hardcode": "node scripts/check-hardcode.mjs",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "check:unused": "knip",
    "check:secrets": "gitleaks git --redact --verbose",
    "check:all": "pnpm check:types && pnpm check:lint && pnpm test && pnpm check:hardcode && pnpm check:boundaries"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.6.0",
    "knip": "6.42.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
