{
  "name": "college-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node worker/index.ts",
    "worker:dev": "node --env-file=.env.local --watch worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local db/seed/base.ts",
    "seed:demo": "node --env-file-if-exists=.env.local db/seed/demo.ts",
    "admin:create": "node --env-file-if-exists=.env.local scripts/admin-create.ts",
    "local:up": "node scripts/local.ts up",
    "local:down": "node scripts/local.ts down",
    "local:share": "node scripts/local.ts share",
    "local:run": "node scripts/local.ts run",
    "identity:sync": "node scripts/identity/sync.ts",
    "check:types": "next typegen && tsc --noEmit",
    "check:lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:screens": "playwright test --config e2e/screens/screens.config.ts",
    "lighthouse": "node --env-file-if-exists=.env.local scripts/lighthouse.ts",
    "check:hardcode": "node scripts/check-hardcode.mjs",
    "check:boundaries": "depcruise src worker db --config .dependency-cruiser.cjs",
    "check:unused": "knip",
    "check:secrets": "gitleaks git --redact --verbose",
    "check:all": "pnpm check:types && pnpm check:lint && pnpm test && pnpm check:hardcode && pnpm check:boundaries"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "0.577.0",
    "motion": "14.4.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "next-safe-action": "8.7.3",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.4.2",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.6.0",
    "drizzle-kit": "0.31.11",
    "knip": "6.42.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
