{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinAllExceptPeerDependencies",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Riyadh",
  "schedule": ["before 6am on sunday"],
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "minor and patch updates",
      "automerge": true
    },
    {
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "matchPackageNames": ["node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Every copy of the PostgreSQL image: compose, CI and tests/support/postgres.ts",
      "matchDepNames": ["postgres"],
      "groupName": "PostgreSQL image"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The PostgreSQL image the test containers run",
      "managerFilePatterns": ["/^tests/support/postgres\\.ts$/"],
      "matchStrings": ["\"(?<depName>postgres):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker"
    }
  ]
}
