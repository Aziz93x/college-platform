# Copy to .env.local for pnpm dev. Values match docker/compose.dev.yml.
APP_ENV=local
APP_URL=http://localhost:3000
DATABASE_URL=postgres://college:college@localhost:5432/college
# Signs session cookies; 32 characters or more. Any value works on a laptop.
AUTH_SECRET=local-only-value-that-signs-cookies-on-this-laptop
# Placeholder values for the one college that pnpm db:seed creates; change them before seeding.
SEED_COLLEGE_NAME="College name"
SEED_COLLEGE_SHORT_NAME="College"
