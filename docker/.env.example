# pnpm local:up writes docker/.env from this file and fills each empty value below with a new random
# one, which it never prints. Keep docker/.env, and never commit it: AUTH_SECRET signs the sessions
# and encrypts the two-factor secrets, and the passwords open the database.
# The laptop's address on the Wi-Fi, which a phone opens beside https://localhost: auto finds it,
# none serves localhost only, or write it (ipconfig on Windows). Under WSL 2, write it.
LAN_ADDRESS=auto
APP_URL=https://localhost
# The tables' owner: migrations, the base seed and the backups connect as it.
POSTGRES_USER=college
POSTGRES_PASSWORD=
POSTGRES_DB=college
# The app and the worker connect as this role, which owns no table (db/migrate.ts).
APP_DATABASE_USER=college_app
APP_DATABASE_PASSWORD=
AUTH_SECRET=
# The one college that the first start creates; set its names before then.
SEED_COLLEGE_NAME="College name"
SEED_COLLEGE_SHORT_NAME="College"
# Demo mode (pnpm local:up --demo): the password of the demo people but the admin; the demo admin's
# own password; the authenticator secret of the admin and the heads; and the admin's ten backup
# codes and the heads' ten (each signs in once per account).
DEMO_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_TOTP_SECRET=
DEMO_BACKUP_CODES=
DEMO_HEAD_BACKUP_CODES=
